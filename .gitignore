.zen/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.venv/

# Runtime state, credentials, and RESTRICTED_SOURCE_NOT_DEIDENTIFIED transcripts
# all live under .zen/ (excluded above). These are belt-and-braces.
*.env
*.token
.zen/factory.env
.zen/status-token.txt
*.orig
*.log

# downloaded binary, not source
bin/cloudflared

# Fine-tuning output. These are RESTRICTED_SOURCE_NOT_DEIDENTIFIED — real
# customer calls carrying names, phone numbers and account digits. They are the
# product of this repo, never part of it.
datasets/
*.jsonl

# Node dependencies and build output; rebuilt with `npm ci && npm run build`.
node_modules/
web/dist/

# Proposals the data-engineer agent writes for human review.
.zen/proposals/
